---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found - Open Conversation Format" noindex>
  <section class="mx-auto max-w-5xl px-6 py-32 text-center">
    <p class="font-mono text-[13px] text-accent-ink">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">This page does not exist.</h1>
    <p class="mt-8">
      <a href="/" class="font-medium text-accent-ink underline underline-offset-4">Back to the start page</a>
    </p>
  </section>
</Layout>
