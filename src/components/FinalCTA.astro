---
import { links } from '../config/site';
---

<section class="border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-20 text-center md:py-28">
    <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight md:text-[2.5rem] md:leading-[1.1]">
      Start with the archive. The rest builds on it.
    </h2>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="#start" class="rounded-md bg-accent px-5 py-3 font-medium text-white transition-opacity hover:opacity-90">
        Get started
      </a>
      <a
        href={links.org}
        class="rounded-md border border-line-strong px-5 py-3 font-medium text-ink transition-colors hover:border-ink"
      >
        View on GitHub
      </a>
    </div>
  </div>
</section>
