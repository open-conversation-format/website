---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead?: string;
}
const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <p class="font-mono text-[13px] text-accent-ink">{eyebrow}</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight md:text-[2.5rem] md:leading-[1.1]">
      {title}
    </h2>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{lead}</p>}
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
