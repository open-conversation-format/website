---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<article class="mx-auto max-w-3xl px-6 pb-24 pt-16 md:pt-24">
  <p class="font-mono text-[13px] text-accent-ink">{eyebrow}</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
  <div class="prose-legal mt-10">
    <slot />
  </div>
</article>
